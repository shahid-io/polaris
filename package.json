{
  "name": "polaris",
  "version": "0.1.0",
  "private": true,
  "description": "Polaris: find your bearing on every fare. Aggregates and compares flight offers across multiple providers.",
  "packageManager": "pnpm@11.21.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:watch": "turbo run test:watch",
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,json,md,yaml,yml}\"",
    "fixtures:record": "node scripts/record-fixtures.mjs",
    "demo": "pnpm --filter @polaris/web demo",
    "lint:fix": "eslint . --fix",
    "demo:video": "pnpm --filter @polaris/web demo:video",
    "fixtures:record:web": "node scripts/record-web-fixtures.mjs",
    "browsers:install": "pnpm --filter @polaris/providers exec playwright install chromium",
    "verify:prices": "node scripts/verify-prices.mjs",
    "qa:sweep": "node scripts/qa-sweep.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "eslint": "^9.39.5",
    "eslint-config-next": "16.3.0",
    "globals": "^17.9.0",
    "prettier": "^3.4.2",
    "turbo": "^2.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0"
  }
}
