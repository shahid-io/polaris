# ─────────────────────────────────────────────────────────────
# Polaris — environment template. Copy to .env and fill in.
# Never commit .env — it is gitignored.
# ─────────────────────────────────────────────────────────────

# Provider mode — controls which adapters ProvidersModule registers.
#   live    : call real provider APIs only
#   fixture : replay recorded responses (deterministic, offline, demo-safe)
#   hybrid  : live, with automatic fixture fallback when a live call fails
PROVIDER_MODE=hybrid

# ── SerpApi (Google Flights) — our real live flight data source ──
# Free tier: 250 searches/month. Key: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# ── Duffel (sandbox) — second vendor contract shape ──
# Test tokens start with duffel_test_. https://app.duffel.com
DUFFEL_ACCESS_TOKEN=

# ── API ──
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000
PROVIDER_TIMEOUT_MS=10000
CACHE_TTL_SECONDS=300

# Circuit breaker: consecutive failures before a provider is tripped open,
# and how long it stays open before a half-open probe.
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_MS=30000

# ── Web ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Search analytics (optional) ──
# Omit entirely to disable analytics. Searches work either way — a database being
# unavailable must never be the reason a flight search fails.
#   docker compose up -d mongo
MONGODB_URI=mongodb://localhost:27017/polaris
