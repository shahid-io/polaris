# ─────────────────────────────────────────────────────────────
# Polaris: environment template. Copy to .env and fill in.
# Never commit .env, it is gitignored.
# ─────────────────────────────────────────────────────────────

# Provider mode: controls which adapters ProvidersModule registers.
#   live    : call real provider APIs only
#   fixture : replay recorded responses (deterministic, offline, demo-safe)
#   hybrid  : live, with automatic fixture fallback when a live call fails
PROVIDER_MODE=hybrid

# ── SerpApi (Google Flights): our real live flight data source ──
# Free tier: 250 searches/month. Key: https://serpapi.com/manage-api-key
SERPAPI_KEY=

# ── Duffel (sandbox): second vendor contract shape ──
# Test tokens start with duffel_test_. https://app.duffel.com
DUFFEL_ACCESS_TOKEN=

# ── Travel agencies (on by default) ──
# Each agency is read from its own public search page: the price Polaris shows is the price
# that seller's site is showing, and every offer links back to it so you can check.
#
# Supported: cleartrip, easemytrip, ixigo. Omit the line entirely to enable all of them.
# Set it to empty to disable them, which leaves only airline fares.
#
# MakeMyTrip and Goibibo are absent because they refuse automated clients at their CDN
# edge; that was measured, not assumed. See docs/INTEGRATIONS.md.
#
# Needs Chromium (usually already present): pnpm browsers:install
# BROWSER_PROVIDERS=cleartrip,easemytrip,ixigo

# live | fixture | hybrid. Hybrid drives the session and replays a recording when it fails,
# labelling the result as replayed rather than current.
BROWSER_PROVIDER_MODE=hybrid

# Browser sessions are deliberately serialised: one page at a time, at the rate a person
# would search. That makes them cumulative, so with all three enabled the last to run needs
# roughly 10s and will graze the default PROVIDER_TIMEOUT_MS below. Raise it accordingly.
PROVIDER_TIMEOUT_MS=20000

# ── API ──
API_PORT=4000
API_CORS_ORIGIN=http://localhost:3000

# A cached response carries the provider statuses as well as the flights, so caching a
# failure at the full TTL would suppress the retry for that whole window. A search where
# something failed is kept only briefly instead.
CACHE_TTL_SECONDS=300
CACHE_PARTIAL_TTL_SECONDS=30

# Circuit breaker: consecutive failures before a provider is tripped open, and how long it
# stays open before a single half-open probe: one, not one per concurrent search.
CIRCUIT_FAILURE_THRESHOLD=3
CIRCUIT_RESET_MS=30000

# ── Web ──
NEXT_PUBLIC_API_BASE_URL=http://localhost:4000

# ── Search analytics (optional) ──
# Omit entirely to disable analytics. Searches work either way. A database being
# unavailable must never be the reason a flight search fails.
#   docker compose up -d mongo
MONGODB_URI=mongodb://localhost:27017/polaris
